  "type": {
    "fonts": [
      {
        "family": "Refraction Sans",
        "file": "fonts/NotoSansSC-Regular.ttf",
        "weight": "400"
      }
    ],
    "families": {
      "sans": "\"Refraction Sans\", \"Noto Sans SC\", Arial, sans-serif"
    },
    "groups": [
      {
        "name": "光学展览层级",
        "family": "sans",
        "styles": [
          {
            "name": "display",
            "fontSize": "180px",
            "lineHeight": 1.0,
            "fontWeight": 900,
            "letterSpacing": "-7px",
            "usage": "横向英文展示字；每个载体按比例调整，避免机械同尺寸。"
          },
          {
            "name": "title",
            "fontSize": "96px",
            "lineHeight": 1.15,
            "fontWeight": 800,
            "letterSpacing": "-2px",
            "usage": "中文展名、提案关键判断。"
          },
          {
            "name": "subtitle",
            "fontSize": "44px",
            "lineHeight": 1.3,
            "fontWeight": 600,
            "usage": "短句和单元标题。"
          },
          {
            "name": "body",
            "fontSize": "28px",
            "lineHeight": 1.65,
            "fontWeight": 400,
            "usage": "提案与规则的完整解释。"
          },
          {
            "name": "meta",
            "fontSize": "24px",
            "lineHeight": 1.5,
            "fontWeight": 400,
            "usage": "日期、地点与入场说明。"
          },
          {
            "name": "caption",
            "fontSize": "18px",
            "lineHeight": 1.5,
            "fontWeight": 400,
            "usage": "图注与编辑标记。"
          }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      {
        "name": "space-xs",
