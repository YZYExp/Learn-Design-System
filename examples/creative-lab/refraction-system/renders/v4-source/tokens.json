      },
      {
        "name": "silver",
        "value": "#C6CBD1",
        "usage": "银色辅助面、图像边界，不能单独代替光学材质。"
      },
      {
        "name": "paper-white",
        "value": "#FFFFFF",
        "usage": "纯白展示面或反白。"
