      },
      {
        "name": "space-s",
        "value": "16px",
        "usage": "同组信息。"
      },
      {
        "name": "space-m",
        "value": "32px",
        "usage": "信息块之间。"
      },
      {
        "name": "space-l",
        "value": "64px",
        "usage": "竖版安全区。"
      },
      {
        "name": "space-xl",
        "value": "80px",
        "usage": "横版与编辑页外边界。"
      }
    ]
  },
  "radius": {
    "tokens": [
      {
        "name": "radius-sharp",
        "value": "0px",
        "usage": "海报、照片与票面的直角边界。"
      },
      {
        "name": "radius-dot",
        "value": "50%",
        "usage": "少量独立标记。"
      }
    ]
  },
  "shadow": {
    "tokens": [
      {
        "name": "shadow-none",
        "value": "none",
        "usage": "不为板块添加卡片阴影；光影由图像本身提供。"
      }
    ]
